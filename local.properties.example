# Copy to local.properties (git-ignored) and fill in. Never commit real keys.
# A root .env file with the same NAME=value lines also works (also git-ignored).
# META_API_KEY (or MODEL_API_KEY) is injected into BuildConfig and used only as
# a fallback when no user-supplied key is stored in EncryptedSharedPreferences
# (Settings screen). CI can provide it via environment variable instead.
# Note: a real key in a build ships inside the APK; keep public APKs keyless.
META_API_KEY=
# Optional Meta Model API endpoint overrides. Defaults are the official
# endpoints (dev.meta.ai/docs): https://api.meta.ai/v1/ for chat/completions
# and wss://api.meta.ai/v1/asr/realtime for voice transcription.
# META_API_BASE_URL=https://api.meta.ai/v1/
# META_STT_URL=wss://api.meta.ai/v1/asr/realtime
