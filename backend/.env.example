# Copy to .env for local runs (never commit .env).
META_API_KEY=
JWT_SECRET=dev-only-change-me
# Web-application OAuth client ID (token audience; same GCP project as the
# Android client that registers com.smartcess.app + SHA-1).
GOOGLE_SERVER_CLIENT_ID=
# Optional overrides (defaults are the official Meta endpoints):
# META_BASE_URL=https://api.meta.ai/v1
# META_STT_URL=wss://api.meta.ai/v1/asr/realtime
# STT_MODEL=muse-voice-transcribe-1.0
