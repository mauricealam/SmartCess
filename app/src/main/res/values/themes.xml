<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launcher/activity theme; Compose SmartCessTheme takes over in content.
         Single white theme: light bars with dark icons, matching MainActivity. -->
    <style name="Theme.SmartCess" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/smartcess_background</item>
        <item name="android:statusBarColor">@color/smartcess_background</item>
        <item name="android:navigationBarColor">@color/smartcess_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- System splash: blue logo reveal on white, then the app theme. -->
    <style name="Theme.SmartCess.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/smartcess_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_splash_mark</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.SmartCess</item>
    </style>
</resources>
