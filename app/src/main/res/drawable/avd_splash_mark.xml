<!-- Splash entrance: letters cascade in left to right (fade + rise), while the
     whole mark gently settles. Total ~950ms. Safe on all API levels; pre-31
     shows the static first frame. Respects reduced motion in code. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/smartcess_logo">
    <target android:name="mark">
        <aapt:attr name="android:animation">
            <set
                android:ordering="together">
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0.96"
                    android:valueTo="1"
                    android:duration="950"
                    android:interpolator="@android:interpolator/decelerate_quint" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0.96"
                    android:valueTo="1"
                    android:duration="950"
                    android:interpolator="@android:interpolator/decelerate_quint" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="l0">
        <aapt:attr name="android:animation">
            <set
                android:ordering="together">
                <objectAnimator
                    android:propertyName="alpha"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:startOffset="0"
                    android:duration="300" />
                <objectAnimator
                    android:propertyName="translateY"
                    android:valueFrom="18"
                    android:valueTo="0"
                    android:startOffset="0"
                    android:duration="450"
                    android:interpolator="@android:interpolator/decelerate_quint" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="l1">
        <aapt:attr name="android:animation">
            <set
                android:ordering="together">
                <objectAnimator
                    android:propertyName="alpha"
                    android:valueFrom="0"
